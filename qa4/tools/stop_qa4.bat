@echo off
chcp 65001 >nul
setlocal EnableExtensions EnableDelayedExpansion

REM 只停止本机 qa4 后端/前端监听进程，不动 Docker 容器。
set "QA4_ROOT=G:\copypan\qa4"
set "ENVFILE=%QA4_ROOT%\backend\.env"
set "BACKEND_PORT=8030"
set "FRONTEND_PORT=5174"

if exist "%ENVFILE%" (
  for /f "usebackq tokens=1,* delims==" %%A in (`findstr /I /R /C:"^[ ]*QA4_PORT=" "%ENVFILE%" 2^>nul`) do (
    set "BACKEND_PORT=%%B"
  )
)
set "BACKEND_PORT=%BACKEND_PORT:"=%"
for /f "tokens=* delims= " %%A in ("%BACKEND_PORT%") do set "BACKEND_PORT=%%A"
if "%BACKEND_PORT%"=="" set "BACKEND_PORT=8030"

if exist "%QA4_ROOT%\frontend\.env.development" (
  for /f "usebackq tokens=1,* delims==" %%A in (`findstr /I /R /C:"^[ ]*VITE_DEV_PORT=" "%QA4_ROOT%\frontend\.env.development" 2^>nul`) do (
    set "FRONTEND_PORT=%%B"
  )
)
set "FRONTEND_PORT=%FRONTEND_PORT:"=%"
for /f "tokens=* delims= " %%A in ("%FRONTEND_PORT%") do set "FRONTEND_PORT=%%A"
if "%FRONTEND_PORT%"=="" set "FRONTEND_PORT=5174"

echo [stop] 检查后端端口 %BACKEND_PORT% 与前端端口 %FRONTEND_PORT% ...

set "QA4_STOP_ROOT=%QA4_ROOT%"
set "QA4_STOP_BACKEND_PORT=%BACKEND_PORT%"
set "QA4_STOP_FRONTEND_PORT=%FRONTEND_PORT%"
powershell -NoProfile -ExecutionPolicy Bypass -EncodedCommand 
set "RC=%ERRORLEVEL%"
echo [stop] 完成。
endlocal & exit /b %RC%
