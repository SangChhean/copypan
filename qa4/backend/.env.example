# qa4 后端环境变量模板。复制为仓库外文件或本目录 .env（已被 gitignore），
# 或由 QA4_ENV_FILE 指向；填入真实值。本文件不含任何真实密钥、密码。
# 约定：尚不知的机密值写 __FILL_ME__，勿把真实值提交进 git。

# 可选：指向外部 env 文件（prompt_trial / get_settings 均认）
QA4_ENV_FILE=

QA4_PORT=8030
# 用户库目录（运行时数据等）；与查表目录独立
QA4_DATA_DIR=
# 查表目录；默认仓库内 qa4/data/lookups，不随 QA4_DATA_DIR 改变
QA4_LOOKUP_DIR=

# Redis（本机 qa4-redis 示例：127.0.0.1:6381；有口令时 redis://:口令@主机:端口/0）
QA4_REDIS_URL=
# 键前缀（默认 qa4:）
QA4_REDIS_PREFIX=

QA4_ES_URL=
QA4_ES_USER=
QA4_ES_PASSWORD=
# 校验证书（默认 1；本机自签 https 可设 0；http 可省略本行）
QA4_ES_VERIFY=

QA4_NEO4J_URI=
QA4_NEO4J_USER=
QA4_NEO4J_PASSWORD=

QA4_JWT_SECRET=
QA4_JWT_EXPIRE_DAYS=
QA4_ADMIN_TOKEN=

QA4_DAILY_LIMIT_DEFAULT=30
QA4_TZ=
QA4_RATE_LIMIT_PER_MINUTE=

OPENROUTER_API_KEY=

# 阶段 1b · Anthropic（优先于 CLAUDE_API_KEY）
QA4_ANTHROPIC_API_KEY=
# 可选；留空则用官方 https://api.anthropic.com
# QA4_ANTHROPIC_BASE_URL=
QA4_MODEL_HAIKU=
QA4_MODEL_SONNET=
QA4_LLM_MAX_CONCURRENCY_HAIKU=
QA4_LLM_MAX_CONCURRENCY_SONNET=
QA4_LLM_TIMEOUT_HAIKU_S=
QA4_LLM_TIMEOUT_SONNET_S=
QA4_LLM_MAX_RETRIES=
QA4_LLM_STRICT_MODEL=

# 兼容旧名；默认 claude-haiku-5-5 / claude-sonnet-5-5
QA4_MODEL_FAST=
QA4_MODEL_MAIN=

QA4_FAKE_LLM=

# ---- 真实检索（嵌入 / 重排；settings → embedding_client / rerank_client）----
# OpenAI 兼容 /embeddings 网关
QA4_EMBED_BASE_URL=
QA4_EMBED_API_KEY=
QA4_EMBED_MODEL=
# Jina 等 /rerank 网关
QA4_RERANK_BASE_URL=
QA4_RERANK_API_KEY=
QA4_RERANK_MODEL=
