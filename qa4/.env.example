# qa4 环境变量示例（复制为 qa4/.env 后填写；服务器上 chmod 600 .env）
# 本文件不得填入真实密码。

QA4_ES_HOST=
QA4_ES_PORT=
QA4_ES_USERNAME=
QA4_ES_PASSWORD=
QA4_ES_HEAP=
QA4_ES_DATA_DIR=
QA4_NEO4J_URI=
QA4_NEO4J_USER=
QA4_NEO4J_PASSWORD=

# --- 服务器（Ubuntu）建议值（写入本机 .env 或 export；本机开发可留空=不限制内存）---
# ES：堆 2g、容器 mem_limit=4g（memswap 同值，禁止该容器用 swap）
#   QA4_ES_HEAP=2g
#   QA4_ES_MEM_LIMIT=4g
# Neo4j：堆 1G、页缓存 512M、容器 mem_limit=2g（memswap 同值）
#   QA4_NEO4J_HEAP=1G
#   QA4_NEO4J_PAGECACHE=512M
#   QA4_NEO4J_MEM_LIMIT=2g
# 数据与日志根目录（linux 脚本默认）：
#   QA4_DATA_ROOT=/opt/qa4_data
#   QA4_LOG_DIR=/opt/qa4_logs
