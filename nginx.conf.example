# Nginx 配置示例 - 前端网站不白屏需保证 root 指向「构建后的 dist」，不能指源码目录
# 用法：把下面 server 块合并到你的 nginx.conf 的 http { } 里，或替换默认 server

server {
    listen       80;
    server_name  localhost;

    # 二选一：指项目里的 dist（推荐），或指 start_all 复制后的目录
    root   E:/copypan/front_mic/frontend/dist;
    # root   C:/nginx-1.24.0/html;
    index  index.html index.htm;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # 后端 API 代理：/api/* 原样转发到 8000（后端路由为 /api/token、/api/search 等）
    # 节期纲目「听抄稿」单接口常需 2～3 分钟（主纲目+序言/添言并行仍可能 >120s）；若 proxy_read_timeout 过短，
    # 会出现：后端日志里 Claude 200、但浏览器拿不到 JSON → 前端无听抄稿/复合。必须先配长超时再配通用 /api/。
    location /api/ai_search/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 300s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 120s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
    }
}
