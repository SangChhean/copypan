# 复制为 .env 后填写（勿提交 .env，已被根目录 .gitignore 的 *.env 规则忽略）
LINE_CHANNEL_ACCESS_TOKEN=你的LINE_Channel_Access_Token
LINE_CHANNEL_SECRET=你的LINE_Channel_Secret

# 搜索 API（默认本机 back_anshifenliang，和 Telegram Bot 用同一个）
ANSHIFENLIANG_API=http://127.0.0.1:8020

# LINE reply token 有效期很短，/api/detail 默认的 60s 超时对 webhook 请求来说太长，
# 这里调低默认值；如果服务器网络延迟大可以按需上调，但要小于 gunicorn 的 --timeout
SEARCH_TIMEOUT=10
DETAIL_TIMEOUT=10

# 欢迎语中的条目数展示（可选）
LOADED_COUNT=12000
