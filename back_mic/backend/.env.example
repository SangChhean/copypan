# 复制本文件为 .env 并填写实际配置（不要将 .env 提交到版本库）

# Claude API（AI 搜索、毛胚纲目润色/初信/青少年/真理/三分钟分享）
CLAUDE_API_KEY=
# 可选：Claude 并发上限，默认 20（同时进行中的请求数，避免 429 限流）
# CLAUDE_CONCURRENT_LIMIT=20

# Elasticsearch
# 若使用 ES 8.19 且映射到 9201，请设置 ES_PORT=9201；ES 8.x 默认开启安全，需设置 ES_PASSWORD
ES_HOST=localhost
ES_PORT=9200

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Gemini API（纲目翻译、毛胚纲目润色/三分钟分享）
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
# 可选：Gemini 并发上限，默认 10（同时进行中的请求数，避免 429 限流）
# GEMINI_CONCURRENT_LIMIT=10

# Deep Seek API（毛胚纲目-三分钟分享，填写后启用）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v3.2

# Perplexity API（毛胚纲目-三分钟分享，填写后启用）
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar-pro

# OpenAI / ChatGPT API（毛胚纲目-三分钟分享，填写后启用）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4

# xAI Grok API（毛胚纲目-三分钟分享，填写后启用）
XAI_API_KEY=
XAI_MODEL=grok-4-1-fast-reasoning

# 双路检索 + Reranker（DESIGN_SPEC_V2）
# Jina Reranker v3：用于检索结果重排。申请 Key 见 https://jina.ai/api-dashboard/key-manager
# 新用户赠送 10M tokens；请求头：Authorization: Bearer jina_xxx
JINA_API_KEY=
# 向量搜索开关（true=双路混合检索，false=纯BM25原逻辑）
USE_VECTOR_SEARCH=false
# Reranker 开关（true=启用 Jina Reranker v3，false=跳过精排直接取 RRF top-k）
USE_RERANK=true
# Jina Reranker API Key（USE_RERANK=true 时必填，见上方 JINA_API_KEY）
# OpenAI API Key（向量化与线上 Embedding 查询用，见上方 OPENAI_API_KEY）
