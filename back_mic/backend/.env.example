# 复制本文件为 .env 并填写实际配置（不要将 .env 提交到版本库）

# Claude API（AI 搜索、毛胚纲目润色/初信/青少年/真理/三分钟分享）
CLAUDE_API_KEY=

# Elasticsearch
ES_HOST=localhost
ES_PORT=9200

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Gemini API（纲目翻译、毛胚纲目润色/三分钟分享）
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# Deep Seek API（毛胚纲目-三分钟分享，填写后启用）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v3.2

# Perplexity API（毛胚纲目-三分钟分享，填写后启用）
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar

# OpenAI / ChatGPT API（毛胚纲目-三分钟分享，填写后启用）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2

# xAI Grok API（毛胚纲目-三分钟分享，填写后启用）
XAI_API_KEY=
XAI_MODEL=grok-4-1-fast
