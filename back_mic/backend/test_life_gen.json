[
  {"id": "life_1-1-1", "text": "第一篇　创世记—总纲与中心思想", "type": "title", "index": ["life"]},
  {"id": "life_1-1-2", "text": "我们为着圣经赞美主！为着包含在这书中的生命，神圣的生命，永远的生命，赞美主！也为着祂给我们这机会，与这么多人，对祂神圣的话语有生命读经而赞美主！", "type": "text", "index": ["life"]},
  {"id": "life_1-1-3", "text": "一本奇妙的书", "type": "heading", "index": ["life"]},
  {"id": "life_1-1-4", "text": "圣经是一本奇妙的书，它是书中之书。", "type": "text", "index": ["life"]},
  {"id": "life_1-1-5", "text": "真奇妙。", "type": "text", "index": ["life"]},
  {"id": "life_1-1-6", "text": "何等的奇妙！", "type": "text", "index": ["life"]},
  {"id": "life_1-1-7", "text": "神的呼出", "type": "heading", "index": ["life"]},
  {"id": "life_1-1-8", "text": "圣经是什么？提后三章十六节说，圣经都是神的呼出。这意思是说，圣经是神所呼出来的话。", "type": "text", "index": ["life"]}
]
