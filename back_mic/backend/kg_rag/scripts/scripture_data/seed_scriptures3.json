    "greek_terms": [
      "airó (G142) stauros (G4716)"
    ],
    "scriptures": [
      {
        "id": "约十九17",
        "text": "他们就把耶稣带了去。耶稣自己背着十字架出来，到了一个地方，名叫髑髅地，希伯来话叫各各他。"
      },
      {
        "id": "太十38",
        "text": "不背起他的十字架，并跟从我的，也配不过我。"
      },
      {
        "id": "太十六24",
        "text": "于是耶稣对门徒说，若有人要跟从我，就当否认己，背起他的十字架，并跟从我。"
      }
    ]
  },
