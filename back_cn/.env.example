# back_cn 环境变量示例
# 复制为 back_cn/.env 并按需填写。共享基础设施变量见 back_mic/backend/.env。

# =============================================================================
# A.1 覆盖共享模块变量（Redis 命名空间隔离，相对主站/QA 改前缀）
# =============================================================================

# ai_search.monitoring 统计键前缀（主站默认 ai_monitoring:）
AI_MONITORING_PREFIX=cn_monitoring:

# back_qa 限流键前缀（QA 默认 qa:ratelimit:）
QA_RATELIMIT_PREFIX=cn:ratelimit:

# back_qa 请求监控列表键（QA 默认 qa:monitor:records）
QA_MONITOR_KEY=cn:monitor:records

# back_qa 问答缓存前缀（QA 默认 qa:cache:）
QA_REDIS_PREFIX=cn:cache:

# =============================================================================
# A.2 CN 站专用变量
# =============================================================================

# 服务端口（默认 8014）
CN_PORT=8014

# JWT 签名密钥（必填，可用 python -c "import secrets;print(secrets.token_hex(32))" 生成）
CN_JWT_SECRET=

# 管理接口 Token（X-Admin-Token 头）
CN_ADMIN_TOKEN=

# 每日配额默认值（建表与注册新用户时使用）
CN_DAILY_LIMIT_OUTLINE=3
CN_DAILY_LIMIT_TRANSLATE=3
CN_DAILY_LIMIT_QA=3
CN_DAILY_LIMIT_BURDEN=20
CN_DAILY_LIMIT_ASR=20
CN_DAILY_LIMIT_ROUNDTABLE=2
CN_DAILY_LIMIT_MINISTRY_PURSUIT=2
CN_DAILY_LIMIT_ES_SEARCH=1

# 资料下载（PDF 存储目录与单文件大小上限 MB）
CN_MATERIALS_DIR=back_cn/uploads/cn_materials
CN_MATERIALS_MAX_MB=200
# 本地开发设为 1 时 download 直接返回 PDF 实体；生产留空，由 Nginx X-Accel-Redirect 传文件
CN_MATERIALS_DIRECT_DOWNLOAD=1

# 职事信息搜寻 Elasticsearch（back_cn 独立配置；ES_HOST 仅填主机/IP，不要带 http://）
ES_HOST=127.0.0.1
ES_PORT=9201
ES_USERNAME=elastic
ES_PASSWORD=

# 职事信息搜寻离线包 zip 的本机绝对路径（本地/服务器各自配置，勿写死在代码里）
# 例：C:\path\to\ES7-offline-search.zip 或 /var/www/cn/ES7-offline-search.zip
OFFLINE_SEARCH_PACKAGE_PATH=
